@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}


.wildlife-scene{position:fixed;inset:0;z-index:0;pointer-events:none;background-size:cover;background-position:center;background-repeat:no-repeat;opacity:.34;filter:saturate(.78) brightness(.62);animation:wildlifeScenes 24s infinite}main{position:relative;z-index:1;background:transparent!important}@keyframes wildlifeScenes{0%,20%{background-image:url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2400&q=85")}25%,45%{background-image:url("https://images.unsplash.com/photo-1752087021432-2524e33d07a7?auto=format&fit=crop&w=2400&q=85")}50%,70%{background-image:url("https://images.unsplash.com/photo-1649012056772-1969e9e82003?auto=format&fit=crop&w=2400&q=85")}75%,95%{background-image:url("https://images.unsplash.com/photo-1525869916826-972885c91c1e?auto=format&fit=crop&w=2400&q=85")}100%{background-image:url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2400&q=85")}}

.support-page,
.dashboard-page {
  min-height: 100vh;
  padding: 80px 7%;
  color: white;
  background: rgba(3, 10, 7, .82);
}

.support-hero,
.dashboard-header {
  max-width: 1000px;
  margin: auto auto 35px;
}

.support-hero h1,
.dashboard-header h1 {
  font-size: clamp(38px, 7vw, 72px);
  margin: 14px 0;
}

.support-hero p,
.dashboard-header p {
  color: #b7c7bf;
  max-width: 700px;
  line-height: 1.7;
}

.support-badge {
  color: #72f7a2;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
}

.support-owner,
.dashboard-owner,
.ticket-card,
.support-info,
.ticket-list {
  max-width: 1000px;
  margin: 20px auto;
  padding: 25px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 20px;
  background: rgba(8, 20, 14, .78);
  backdrop-filter: blur(14px);
}

.support-owner {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.support-owner a {
  color: #72f7a2;
}

.ticket-card form {
  display: grid;
  gap: 14px;
  margin-top: 25px;
}

.ticket-card input,
.ticket-card select,
.ticket-card textarea,
.ticket-meta select {
  width: 100%;
  padding: 14px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.12);
  background: #07110c;
  color: white;
}

.ticket-card textarea {
  min-height: 150px;
  resize: vertical;
}

.ticket-card button,
.list-title button {
  padding: 13px 18px;
  border: 0;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 800;
}

.ticket-result {
  padding: 14px;
  border-radius: 12px;
  background: rgba(114,247,162,.1);
  color: #72f7a2;
}

.support-info {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.support-info div {
  padding: 18px;
  border-radius: 15px;
  background: rgba(255,255,255,.04);
}

.support-info span,
.dashboard-owner span {
  display: block;
  color: #aabbb2;
  margin-top: 7px;
}

.premium-box {
  border: 1px solid rgba(255,190,70,.35) !important;
}

.online-status {
  display: inline-block;
  padding: 10px 15px;
  border-radius: 999px;
  background: rgba(114,247,162,.1);
  color: #72f7a2;
}

.ticket-list {
  margin-top: 25px;
}

.list-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ticket-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 14px;
  padding: 20px;
  border-radius: 15px;
  background: rgba(255,255,255,.04);
}

.priority-ticket {
  border: 1px solid rgba(255,190,70,.35);
}

.ticket-row h3 {
  margin: 8px 0;
}

.ticket-row p {
  color: #9dafa5;
}

.ticket-meta {
  min-width: 150px;
}

.priority {
  display: block;
  color: #ffc45c;
  font-size: 12px;
  font-weight: 800;
  margin-bottom: 8px;
}

.empty {
  color: #9aa9a1;
}

@media (max-width: 700px) {
  .support-page,
  .dashboard-page {
    padding: 50px 18px;
  }

  .support-info {
    grid-template-columns: 1fr;
  }

  .ticket-row {
    flex-direction: column;
  }

  .ticket-meta {
    width: 100%;
  }
}

.owner-page {
  min-height: 100vh;
  padding: 70px 7%;
  color: white;
  background: rgba(3, 10, 7, .88);
}

.owner-header,
.owner-card,
.owner-notice {
  max-width: 900px;
  margin-left: auto;
  margin-right: auto;
}

.owner-header {
  margin-bottom: 25px;
}

.owner-header h1 {
  font-size: clamp(40px, 7vw, 70px);
  margin: 12px 0;
}

.owner-card {
  padding: 25px;
  margin-top: 18px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 20px;
  background: rgba(8,20,14,.82);
  backdrop-filter: blur(14px);
}

.owner-card h2 {
  margin: 10px 0;
}

.owner-card input,
.owner-card textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 12px;
  padding: 14px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 12px;
  background: #07110c;
  color: white;
}

.owner-card textarea {
  min-height: 130px;
  resize: vertical;
}

.support-toggle,
.primary-owner-button {
  margin-top: 18px;
  padding: 14px 20px;
  border: 0;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 800;
}

.support-toggle.on {
  background: rgba(114,247,162,.15);
  color: #72f7a2;
}

.support-toggle.off {
  background: rgba(255,80,80,.15);
  color: #ff7777;
}

.primary-owner-button {
  background: #72f7a2;
  color: #06100a;
}

.primary-owner-button:disabled {
  opacity: .4;
  cursor: not-allowed;
}

.time-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  margin-top: 18px;
}

.time-grid label {
  color: #aebdb5;
}

.owner-note {
  color: #72f7a2;
}

.owner-notice {
  margin-top: 18px;
  padding: 15px;
  border-radius: 12px;
  background: rgba(114,247,162,.1);
  color: #72f7a2;
}

@media (max-width: 600px) {
  .owner-page {
    padding: 45px 18px;
  }

  .time-grid {
    grid-template-columns: 1fr;
  }
}

.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 25px;
  box-sizing: border-box;
  color: white;
  background: rgba(3, 10, 7, .88);
}

.auth-card {
  width: min(440px, 100%);
  padding: 32px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 22px;
  background: rgba(8,20,14,.88);
  backdrop-filter: blur(16px);
  box-sizing: border-box;
}

.auth-card h1 {
  font-size: 38px;
  margin: 14px 0 8px;
}

.auth-card > p {
  color: #9daaa3;
}

.auth-card form {
  margin-top: 25px;
}

.auth-card input {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 13px;
  padding: 14px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 12px;
  background: #07110c;
  color: white;
  outline: none;
}

.auth-card input:focus {
  border-color: rgba(114,247,162,.6);
}

.auth-card button {
  width: 100%;
  padding: 14px;
  border: 0;
  border-radius: 12px;
  background: #72f7a2;
  color: #06100a;
  font-weight: 800;
  cursor: pointer;
}

.auth-card button:disabled {
  opacity: .55;
  cursor: wait;
}

.auth-error {
  margin: 5px 0 13px;
  padding: 11px;
  border-radius: 10px;
  background: rgba(255,70,70,.1);
  color: #ff8585;
}

.auth-footer {
  text-align: center;
  margin-top: 22px;
}

.auth-footer a {
  color: #72f7a2;
  text-decoration: none;
}

.oauth-buttons {
  display: grid;
  gap: 10px;
  margin-top: 22px;
}

.oauth-button {
  width: 100%;
  padding: 13px !important;
  border: 1px solid rgba(255,255,255,.12) !important;
  border-radius: 12px !important;
  background: rgba(255,255,255,.05) !important;
  color: white !important;
  font-weight: 700;
}

.oauth-button:hover {
  background: rgba(255,255,255,.09) !important;
}

.auth-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 20px 0;
  color: #718078;
  font-size: 12px;
}

.auth-divider::before,
.auth-divider::after {
  content: "";
  height: 1px;
  flex: 1;
  background: rgba(255,255,255,.1);
}

.auth-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #050807 !important;
}

.auth-page::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  background:
    linear-gradient(rgba(3,12,8,.38), rgba(3,8,6,.72)),
    url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2400&q=85")
    center 25% / cover no-repeat;
  animation: authWildlife 24s infinite;
}

.auth-card {
  position: relative;
  z-index: 2;
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  background: rgba(4, 18, 12, 0.72) !important;
  border: 1px solid rgba(140, 255, 190, 0.18) !important;
  box-shadow: 0 25px 80px rgba(0,0,0,.55);
}

@keyframes authWildlife {
  0%, 20% {
    background-image:
      linear-gradient(rgba(3,12,8,.38), rgba(3,8,6,.72)),
      url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2400&q=85");
  }
  25%, 45% {
    background-image:
      linear-gradient(rgba(3,12,8,.38), rgba(3,8,6,.72)),
      url("https://images.unsplash.com/photo-1752087021432-2524e33d07a7?auto=format&fit=crop&w=2400&q=85");
  }
  50%, 70% {
    background-image:
      linear-gradient(rgba(3,12,8,.38), rgba(3,8,6,.72)),
      url("https://images.unsplash.com/photo-1649012056772-1969e9e82003?auto=format&fit=crop&w=2400&q=85");
  }
  75%, 95% {
    background-image:
      linear-gradient(rgba(3,12,8,.38), rgba(3,8,6,.72)),
      url("https://images.unsplash.com/photo-1525869916826-972885c91c1e?auto=format&fit=crop&w=2400&q=85");
  }
}

.auth-card > * {
  position: relative;
  z-index: 3;
}


.auth-scenery {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  background: #020504;
}

.auth-scene {
  position: absolute;
  inset: -2%;
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  opacity: 0;
  transform: scale(1.03);
  animation: loginWildlife 32s ease-in-out infinite;
}

.auth-scene::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(rgba(0, 8, 5, .58), rgba(0, 5, 4, .78)),
    radial-gradient(circle at center, transparent 20%, rgba(0, 0, 0, .42) 100%);
}

.auth-scene-1 {
  background-image: url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2400&q=85");
  animation-delay: 0s;
}

.auth-scene-2 {
  background-image: url("https://images.unsplash.com/photo-1752087021432-2524e33d07a7?auto=format&fit=crop&w=2400&q=85");
  animation-delay: 8s;
}

.auth-scene-3 {
  background-image: url("https://images.unsplash.com/photo-1649012056772-1969e9e82003?auto=format&fit=crop&w=2400&q=85");
  animation-delay: 16s;
}

.auth-scene-4 {
  background-image: url("https://images.unsplash.com/photo-1525869916826-972885c91c1e?auto=format&fit=crop&w=2400&q=85");
  animation-delay: 24s;
}

.auth-card {
  z-index: 2;
}

@keyframes loginWildlife {
  0%, 20% {
    opacity: 0;
  }

  5%, 17% {
    opacity: 1;
  }

  25%, 100% {
    opacity: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .auth-scene {
    animation: none;
  }

  .auth-scene-1 {
    opacity: 1;
  }
}



/* Dark landing-page controls */
main button {
  transition:
    background-color 700ms ease,
    border-color 700ms ease,
    transform 700ms ease,
    box-shadow 700ms ease;
}

main button:hover {
  background: rgba(25, 65, 47, 0.92) !important;
  border-color: rgba(155, 255, 200, 0.25) !important;
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(0,0,0,.35);
}

/* Slower wildlife scenery */
.wildlife-scene {
  animation-duration: 48s !important;
}

/* Dark hosting modal buttons */
main a[href*="discord.gg"],
main button {
  transition: all 700ms ease !important;
}

main a[href*="discord.gg"] {
  background: rgba(18, 45, 33, 0.88) !important;
  border: 1px solid rgba(155, 255, 200, 0.16) !important;
}

main a[href*="discord.gg"]:hover {
  background: rgba(25, 65, 47, 0.94) !important;
}


.policy-page {
  min-height: 100vh;
  padding: 70px 20px;
  background: #050807;
  color: #e8eee9;
}

.policy-card {
  max-width: 900px;
  margin: auto;
  padding: 42px;
  border: 1px solid rgba(140,255,190,.12);
  border-radius: 20px;
  background: rgba(8,18,13,.92);
  box-shadow: 0 25px 80px rgba(0,0,0,.55);
}

.policy-card h1 {
  font-size: clamp(38px, 7vw, 64px);
  margin: 12px 0;
}

.policy-card h2 {
  margin-top: 34px;
  margin-bottom: 10px;
  color: #9be7ad;
}

.policy-card p {
  color: #aebbb2;
  line-height: 1.8;
}

.policy-card a {
  color: #9be7ad;
  text-decoration: none;
}

.policy-label {
  margin-top: 45px;
  letter-spacing: 2px;
  color: #7ecf91 !important;
  font-size: 13px;
}

.policy-muted {
  color: #68756d !important;
  font-size: 13px;
}

@media (max-width: 600px) {
  .policy-card {
    padding: 25px 20px;
  }
}

